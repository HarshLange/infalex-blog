---
import BaseLayout from "./BaseLayout.astro";

const { title, description, date, thumbnail, readTime } = Astro.props;
---

<BaseLayout title={title} description={description}>
  
  <!-- Reading progress bar -->
  <div class="reading-time-bar" id="reading-bar"></div>

  <!-- ═══ POST HERO ═══ -->
  <div class="post-hero">
    <div style="max-width:800px; margin:0 auto; padding:0 24px;">
      
      <div class="animate-fade-up" style="margin-bottom:20px;">
        <a href="/blog" style="display:inline-flex; align-items:center; gap:6px; font-size:0.8125rem; font-weight:600; color:var(--text-secondary); text-decoration:none; transition:color 0.2s; padding:6px 0;" onmouseover="this.style.color='var(--blue-vivid)'" onmouseout="this.style.color='var(--text-secondary)'">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M12 5l-7 7 7 7"/></svg>
          All Articles
        </a>
      </div>

      <div class="animate-fade-up stagger-1" style="display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:20px;">
        <span class="post-meta-tag">Career Guide</span>
        <span style="font-size:0.8125rem; color:var(--text-muted); display:flex; align-items:center; gap:6px;">
          <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          {new Date(date).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}
        </span>
        <span style="font-size:0.8125rem; color:var(--text-muted); display:flex; align-items:center; gap:6px;">
          <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          {readTime}
        </span>
      </div>

      <h1 class="animate-fade-up stagger-2" style="font-size:clamp(1.875rem,4.5vw,2.875rem); font-weight:800; letter-spacing:-0.04em; line-height:1.1; color:var(--ink); margin-bottom:20px;">
        {title}
      </h1>

      <p class="animate-fade-up stagger-3" style="font-size:1.125rem; color:var(--text-secondary); line-height:1.7; max-width:640px;">
        {description}
      </p>

      <!-- Share row -->
      <div class="animate-fade-up stagger-4" style="display:flex; align-items:center; gap:12px; margin-top:28px; flex-wrap:wrap;">
        <span style="font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted);">Share</span>
        <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(`https://blog.infalex.com`)}`} target="_blank" rel="noopener" style="display:inline-flex; align-items:center; gap:6px; padding:7px 14px; background:var(--surface-3); border:1px solid var(--border); border-radius:8px; font-size:0.8125rem; font-weight:600; color:var(--text-secondary); text-decoration:none; transition:background 0.2s, color 0.2s;" onmouseover="this.style.background='var(--blue-soft)'; this.style.color='var(--blue-vivid)';" onmouseout="this.style.background='var(--surface-3)'; this.style.color='var(--text-secondary)';">
          <svg width="13" height="13" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          Twitter
        </a>
        <button onclick="navigator.clipboard.writeText(window.location.href); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy Link', 2000);" style="display:inline-flex; align-items:center; gap:6px; padding:7px 14px; background:var(--surface-3); border:1px solid var(--border); border-radius:8px; font-size:0.8125rem; font-weight:600; color:var(--text-secondary); cursor:pointer; transition:background 0.2s, color 0.2s; font-family:'Sora',sans-serif;" onmouseover="this.style.background='var(--blue-soft)'; this.style.color='var(--blue-vivid)';" onmouseout="this.style.background='var(--surface-3)'; this.style.color='var(--text-secondary)';">
          <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
          Copy Link
        </button>
      </div>
    </div>
  </div>

  <!-- ═══ THUMBNAIL ═══ -->
  {thumbnail && (
    <div style="max-width:960px; margin:0 auto; padding:0 24px; margin-top:-1px;">
      <div class="animate-scale-up" style="border-radius:24px; overflow:hidden; box-shadow:var(--shadow-xl); border:1px solid var(--border); margin:32px 0;">
        <img src={thumbnail} alt={title} loading="eager" style="width:100%; display:block; object-fit:cover;" />
      </div>
    </div>
  )}

  <!-- ═══ POST BODY ═══ -->
  <article style="max-width:800px; margin:0 auto; padding:0 24px 80px;">
    
    <!-- Progress indicator -->
    <div style="display:flex; align-items:center; gap:16px; padding:16px 0 32px; border-bottom:1px solid var(--border); margin-bottom:40px;">
      <div style="flex:1; height:3px; background:var(--surface-3); border-radius:2px; overflow:hidden;">
        <div id="inline-progress" style="height:100%; width:0%; background:linear-gradient(90deg,var(--blue-vivid),var(--accent)); border-radius:2px; transition:width 0.1s;"></div>
      </div>
      <span id="progress-text" style="font-size:0.75rem; font-weight:600; color:var(--text-muted); white-space:nowrap;">0% read</span>
    </div>

    <div class="prose-custom prose prose-lg max-w-none">
      <slot />
    </div>

    <!-- ═══ AUTHOR CARD ═══ -->
    <div class="author-card" style="margin-top:56px;">
      <div class="author-avatar">I</div>
      <div>
        <p style="font-weight:700; font-size:1rem; color:var(--ink); margin-bottom:2px;">Infalex Editorial</p>
        <p style="font-size:0.875rem; color:var(--text-secondary);">Career guidance & technical writing — helping you navigate the modern job market with clarity and confidence.</p>
      </div>
    </div>

    <!-- ═══ SHARE FOOTER ═══ -->
    <div style="margin-top:40px; padding:28px; background:var(--surface-2); border-radius:16px; border:1px solid var(--border); text-align:center;">
      <p style="font-size:0.9375rem; font-weight:700; color:var(--ink); margin-bottom:16px;">Found this helpful? Share it.</p>
      <div style="display:flex; gap:10px; justify-content:center; flex-wrap:wrap;">
        <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title + ' via @infalex')}&url=${encodeURIComponent('https://blog.infalex.com')}`} target="_blank" rel="noopener" class="btn-primary" style="padding:10px 20px; font-size:0.875rem;">
          Share on Twitter
        </a>
        <a href="/blog" class="btn-secondary" style="padding:10px 20px; font-size:0.875rem;">
          More Articles
        </a>
      </div>
    </div>

    <!-- ═══ RELATED ARTICLES ═══ -->
    <div style="margin-top:60px;">
      <h3 style="font-size:1.125rem; font-weight:800; letter-spacing:-0.03em; color:var(--ink); margin-bottom:20px;">Continue Reading</h3>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;" class="related-grid">
        {[
          { title: 'ATS Resume Format 2026', slug: 'best-ats-resume-format' },
          { title: 'Top Resume Keywords', slug: 'top-resume-keywords-recruiters-look' },
          { title: 'Resume vs CV Differences', slug: 'resume-vs-cv-difference-guide' },
          { title: 'How Long Should a Resume Be', slug: 'how-long-should-a-resume-be' },
        ].map(item => (
          <a href={`/posts/${item.slug}`} style="display:flex; align-items:center; gap:12px; padding:14px 16px; background:var(--surface); border:1px solid var(--border); border-radius:12px; text-decoration:none; transition:transform 0.2s, box-shadow 0.2s, border-color 0.2s; font-size:0.875rem; font-weight:600; color:var(--text-primary);" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='var(--shadow-md)'; this.style.borderColor='rgba(37,99,235,0.2)';" onmouseout="this.style.transform=''; this.style.boxShadow=''; this.style.borderColor='var(--border)';">
            <span style="width:32px; height:32px; background:var(--blue-soft); border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:0.875rem; flex-shrink:0;">📄</span>
            {item.title}
          </a>
        ))}
      </div>
    </div>
  </article>

  <style>
    @media (max-width: 560px) {
      .related-grid { grid-template-columns: 1fr !important; }
    }
  </style>

  <script>
    // Reading progress
    const readingBar = document.getElementById('reading-bar');
    const inlineProgress = document.getElementById('inline-progress');
    const progressText = document.getElementById('progress-text');
    const article = document.querySelector('article');

    function updateReadingProgress() {
      if (!article) return;
      const rect = article.getBoundingClientRect();
      const articleTop = article.offsetTop;
      const articleHeight = article.offsetHeight;
      const scrolled = window.scrollY - articleTop + window.innerHeight;
      const progress = Math.max(0, Math.min(100, (scrolled / articleHeight) * 100));
      
      document.documentElement.style.setProperty('--reading-progress', progress + '%');
      if (inlineProgress) inlineProgress.style.width = progress + '%';
      if (progressText) progressText.textContent = Math.round(progress) + '% read';
    }

    window.addEventListener('scroll', updateReadingProgress, { passive: true });
    updateReadingProgress();
  </script>

</BaseLayout>