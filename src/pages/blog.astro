---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts")).sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);

const readTimeFor = (body: string) => Math.ceil(body.split(/\s+/g).length / 200);
---

<BaseLayout
  title="Blog – Infalex"
  description="Practical guides on resume building, ATS optimization, career paths, and more for the modern digital economy."
>

<!-- ═══ HERO ═══ -->
<section style="background:var(--surface-2); padding:80px 0 64px; border-bottom:1px solid var(--border); position:relative; overflow:hidden;">
  <div style="position:absolute; inset:0; background-image:linear-gradient(rgba(37,99,235,0.04) 1px,transparent 1px),linear-gradient(90deg,rgba(37,99,235,0.04) 1px,transparent 1px); background-size:40px 40px; mask-image:radial-gradient(ellipse at center, black 40%, transparent 80%);"></div>
  
  <div style="max-width:1200px; margin:0 auto; padding:0 24px; position:relative; z-index:1; text-align:center;">
    <div class="animate-fade-up" style="display:inline-flex; align-items:center; gap:8px; padding:5px 14px; background:rgba(37,99,235,0.08); border:1px solid rgba(37,99,235,0.2); border-radius:100px; font-size:0.75rem; font-weight:700; color:var(--blue-vivid); letter-spacing:0.06em; text-transform:uppercase; margin-bottom:20px;">
      📚 All Articles
    </div>

    <h1 class="animate-fade-up stagger-1" style="font-size:clamp(2rem,5vw,3.5rem); font-weight:800; letter-spacing:-0.04em; margin-bottom:16px;">
      Career <span class="gradient-text">Insights</span> & Guides
    </h1>
    <p class="animate-fade-up stagger-2" style="font-size:1.0625rem; color:var(--text-secondary); max-width:480px; margin:0 auto;">
      Practical, no-fluff articles to help you build a better resume, beat the ATS, and land interviews.
    </p>

    <!-- Search bar (decorative) -->
    <div class="animate-fade-up stagger-3" style="max-width:440px; margin:32px auto 0; position:relative;">
      <div style="position:absolute; left:16px; top:50%; transform:translateY(-50%); color:var(--text-muted);">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      </div>
      <input type="text" placeholder="Search articles..." id="search-input" style="width:100%; padding:14px 16px 14px 44px; border:1.5px solid var(--border-strong); border-radius:12px; font-family:'Sora',sans-serif; font-size:0.9375rem; background:var(--surface); color:var(--text-primary); outline:none; transition:border-color 0.2s, box-shadow 0.2s;" onfocus="this.style.borderColor='var(--blue-vivid)'; this.style.boxShadow='0 0 0 3px rgba(37,99,235,0.12)';" onblur="this.style.borderColor='var(--border-strong)'; this.style.boxShadow='none';" />
    </div>
  </div>
</section>

<!-- ═══ POSTS GRID ═══ -->
<section style="padding:72px 0 96px; background:var(--surface);">
  <div style="max-width:1200px; margin:0 auto; padding:0 24px;">
    
    <!-- Count -->
    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:36px; flex-wrap:wrap; gap:12px;">
      <p style="font-size:0.875rem; color:var(--text-muted);">
        Showing <span style="color:var(--ink); font-weight:700;" id="post-count">{posts.length}</span> articles
      </p>
      <div style="display:flex; gap:8px; align-items:center; font-size:0.8125rem; color:var(--text-muted);">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12"/></svg>
        Latest first
      </div>
    </div>

    <div id="posts-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:24px;" class="posts-main-grid">
      {posts.map((post, i) => {
        const readTime = readTimeFor(post.body);
        const date = new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        return (
          <a 
            href={`/posts/${post.slug}`} 
            class="post-card reveal" 
            style={`transition-delay:${(i % 3) * 0.08}s; text-decoration:none;`}
            data-title={post.data.title.toLowerCase()}
            data-desc={post.data.description?.toLowerCase()}
          >
            <div class="post-card-image">
              {post.data.thumbnail ? (
                <img src={post.data.thumbnail} alt={post.data.title} loading="lazy" />
              ) : (
                <div style="width:100%; height:100%; background:linear-gradient(135deg,var(--blue-soft),rgba(6,182,212,0.1)); display:flex; align-items:center; justify-content:center; font-size:2.5rem;">📄</div>
              )}
            </div>
            <div class="post-card-body">
              <span class="post-tag">Career Guide</span>
              <h2 class="post-card-title">{post.data.title}</h2>
              <p class="post-card-excerpt">{post.data.description}</p>
              <div class="post-card-footer">
                <div style="font-size:0.75rem; color:var(--text-muted);">
                  {date} · {readTime} min read
                </div>
                <span class="read-more-arrow">
                  Read
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </span>
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Empty state -->
    <div id="no-results" style="display:none; text-align:center; padding:80px 24px;">
      <div style="font-size:3rem; margin-bottom:16px;">🔍</div>
      <h3 style="font-size:1.25rem; font-weight:700; color:var(--ink); margin-bottom:8px;">No articles found</h3>
      <p style="color:var(--text-secondary);">Try a different search term.</p>
    </div>
  </div>
</section>

<!-- ═══ CTA ═══ -->
<section style="padding:64px 0; background:var(--surface-2); border-top:1px solid var(--border);">
  <div style="max-width:640px; margin:0 auto; padding:0 24px; text-align:center;">
    <div class="reveal" style="background:white; border:1px solid var(--border); border-radius:24px; padding:40px; box-shadow:var(--shadow-md);">
      <div style="font-size:2rem; margin-bottom:12px;">🚀</div>
      <h3 style="font-size:1.375rem; font-weight:800; letter-spacing:-0.03em; margin-bottom:10px;">Check Your Resume Score</h3>
      <p style="font-size:0.9375rem; color:var(--text-secondary); margin-bottom:24px;">
        See how well your resume performs against real ATS systems with our free analyzer.
      </p>
      <a href="https://tools.infalex.com" class="btn-primary" style="margin:0 auto;">
        Try Free ATS Scanner →
      </a>
    </div>
  </div>
</section>

<style>
  @media (max-width: 900px) {
    .posts-main-grid { grid-template-columns: repeat(2, 1fr) !important; }
  }
  @media (max-width: 560px) {
    .posts-main-grid { grid-template-columns: 1fr !important; }
  }
</style>

<script>
  const input = document.getElementById('search-input') as HTMLInputElement;
  const cards = document.querySelectorAll('#posts-grid .post-card') as NodeListOf<HTMLElement>;
  const countEl = document.getElementById('post-count');
  const noResults = document.getElementById('no-results');

  input?.addEventListener('input', () => {
    const q = input.value.toLowerCase().trim();
    let visible = 0;
    cards.forEach(card => {
      const title = card.dataset.title || '';
      const desc = card.dataset.desc || '';
      const match = !q || title.includes(q) || desc.includes(q);
      card.style.display = match ? '' : 'none';
      if (match) visible++;
    });
    if (countEl) countEl.textContent = String(visible);
    if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
  });
</script>

</BaseLayout>