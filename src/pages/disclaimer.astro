---
import BaseLayout from "../layouts/BaseLayout.astro";

const lastUpdated = "February 2026";

const sections = [
  {
    icon: "📋",
    title: "General Information Only",
    content:
      "All content published on Infalex.com — including articles, guides, templates, and any other materials — is provided for general educational and informational purposes only. Nothing on this website constitutes professional legal, financial, medical, or career advice.",
  },
  {
    icon: "🎯",
    title: "No Professional Advice",
    content:
      "While we strive to ensure that all content is accurate, helpful, and up to date, Infalex makes no warranties or representations of any kind regarding the completeness, reliability, suitability, or accuracy of the information contained on this website. We are not licensed attorneys, financial advisors, certified career counsellors, or professional recruiters.",
  },
  {
    icon: "⚠️",
    title: "Assumption of Risk",
    content:
      "Any action you take based on the information found on Infalex.com is strictly at your own risk. Infalex and its contributors will not be liable for any losses, damages, or negative outcomes — direct or indirect — that arise from your use of, or reliance on, the content published here.",
  },
  {
    icon: "🔗",
    title: "External Links",
    content:
      "Our articles may contain links to external websites, tools, or resources operated by third parties. These links are provided for convenience and informational purposes only. Infalex does not endorse, control, or take responsibility for the content, accuracy, or availability of those external sites. Clicking external links is done entirely at your own discretion.",
  },
  {
    icon: "🔄",
    title: "Content Changes",
    content:
      "The job market, hiring practices, and technology landscape change rapidly. While we make every effort to keep our guides current, some information may become outdated between updates. We encourage you to verify critical information — especially regarding specific employers, tools, or regulations — through official or primary sources before making important decisions.",
  },
  {
    icon: "📧",
    title: "Affiliate & Sponsored Content",
    content:
      "Some of our articles may contain affiliate links or references to products and services that we find genuinely useful. If you purchase through an affiliate link, we may earn a small commission at no additional cost to you. Sponsored content, when present, will always be clearly labeled. Our editorial opinions remain independent.",
  },
];
---

<BaseLayout
  title="Disclaimer – Infalex"
  description="Important disclaimers regarding the educational content published on Infalex."
>

  <!-- ══ HERO ══ -->
  <section style="background:var(--surface-2); padding:80px 0 56px; border-bottom:1px solid var(--border); position:relative; overflow:hidden;">
    <div style="position:absolute; inset:0; background-image:linear-gradient(rgba(37,99,235,0.04) 1px,transparent 1px),linear-gradient(90deg,rgba(37,99,235,0.04) 1px,transparent 1px); background-size:40px 40px; mask-image:radial-gradient(ellipse at center,black 40%,transparent 80%);"></div>

    <div style="max-width:760px; margin:0 auto; padding:0 24px; position:relative; z-index:1;">
      <a href="/" class="animate-fade-up" style="display:inline-flex; align-items:center; gap:6px; font-size:0.8125rem; font-weight:600; color:var(--text-secondary); text-decoration:none; margin-bottom:24px; transition:color 0.2s;" onmouseover="this.style.color='var(--blue-vivid)'" onmouseout="this.style.color='var(--text-secondary)'">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M12 5l-7 7 7 7"/></svg>
        Home
      </a>

      <div class="animate-fade-up stagger-1" style="display:inline-flex; align-items:center; gap:8px; padding:5px 14px; background:rgba(245,158,11,0.1); border:1px solid rgba(245,158,11,0.25); border-radius:100px; font-size:0.75rem; font-weight:700; color:#b45309; letter-spacing:0.06em; text-transform:uppercase; margin-bottom:20px;">
        ⚠️ Legal Notice
      </div>

      <h1 class="animate-fade-up stagger-2" style="font-size:clamp(2rem,5vw,3rem); font-weight:800; letter-spacing:-0.04em; margin-bottom:16px; color:var(--ink);">
        Disclaimer
      </h1>

      <p class="animate-fade-up stagger-3" style="font-size:1.0625rem; color:var(--text-secondary); line-height:1.75; max-width:600px;">
        Please read this disclaimer carefully before using or relying on any content published on Infalex.com.
      </p>

      <div class="animate-fade-up stagger-4" style="display:flex; align-items:center; gap:8px; margin-top:24px; font-size:0.8125rem; color:var(--text-muted);">
        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        Last updated: {lastUpdated}
      </div>
    </div>
  </section>

  <!-- ══ CONTENT ══ -->
  <section style="padding:72px 0 96px; background:var(--surface);">
    <div style="max-width:760px; margin:0 auto; padding:0 24px;">

      <!-- Quick summary card -->
      <div class="reveal" style="background:linear-gradient(135deg,rgba(245,158,11,0.06),rgba(239,68,68,0.04)); border:1px solid rgba(245,158,11,0.2); border-radius:20px; padding:28px 32px; margin-bottom:56px; display:flex; gap:20px; align-items:flex-start;">
        <div style="font-size:1.75rem; flex-shrink:0; margin-top:2px;">💡</div>
        <div>
          <h2 style="font-size:1rem; font-weight:800; color:var(--ink); margin-bottom:8px; letter-spacing:-0.02em;">TL;DR — The Short Version</h2>
          <p style="font-size:0.9375rem; color:var(--text-secondary); line-height:1.7; margin:0;">
            Everything on Infalex is for <strong style="color:var(--ink);">educational purposes only</strong>. We are not professionals giving formal advice. Always do your own research and consult qualified professionals before making significant career or financial decisions.
          </p>
        </div>
      </div>

      <!-- Sections -->
      <div style="display:flex; flex-direction:column; gap:36px;">
        {sections.map((section, i) => (
          <div class="reveal" style={`transition-delay:${i * 0.07}s;`}>
            <div style="display:flex; gap:20px; align-items:flex-start;">
              <div style="width:44px; height:44px; background:var(--surface-2); border:1px solid var(--border); border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:1.25rem; flex-shrink:0;">
                {section.icon}
              </div>
              <div style="flex:1;">
                <h2 style="font-size:1.125rem; font-weight:800; letter-spacing:-0.03em; color:var(--ink); margin-bottom:10px;">
                  {section.title}
                </h2>
                <p style="font-size:0.9375rem; color:var(--text-secondary); line-height:1.8; margin:0;">
                  {section.content}
                </p>
              </div>
            </div>
            {i < sections.length - 1 && (
              <div style="margin-top:36px; height:1px; background:linear-gradient(90deg,transparent,var(--border),transparent);"></div>
            )}
          </div>
        ))}
      </div>

      <!-- Due diligence block -->
      <div class="reveal" style="margin-top:56px; background:var(--surface-2); border:1px solid var(--border); border-radius:20px; padding:32px;">
        <h3 style="font-size:1.0625rem; font-weight:800; letter-spacing:-0.025em; color:var(--ink); margin-bottom:12px;">Always Do Your Own Due Diligence</h3>
        <p style="font-size:0.9375rem; color:var(--text-secondary); line-height:1.8; margin-bottom:20px;">
          Before making significant career decisions — such as accepting or declining a job offer, choosing a degree program, or investing in a course — we strongly encourage you to consult with qualified professionals and cross-reference information with official, authoritative sources.
        </p>
        <p style="font-size:0.9375rem; color:var(--text-secondary); line-height:1.8; margin:0;">
          By continuing to use this website, you acknowledge that you have read and agree to this disclaimer.
        </p>
      </div>

      <!-- Contact row -->
      <div class="reveal" style="margin-top:40px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px; padding:24px 28px; background:var(--ink); border-radius:16px;">
        <div>
          <p style="font-size:0.9375rem; font-weight:700; color:white; margin-bottom:4px;">Questions about this disclaimer?</p>
          <p style="font-size:0.8125rem; color:rgba(255,255,255,0.55); margin:0;">We're happy to clarify anything.</p>
        </div>
        <a href="/contact" style="display:inline-flex; align-items:center; gap:8px; padding:10px 20px; background:white; color:var(--ink); font-family:'Sora',sans-serif; font-weight:700; font-size:0.875rem; border-radius:10px; text-decoration:none; transition:opacity 0.2s;" onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
          Contact Us →
        </a>
      </div>

      <!-- Related legal pages -->
      <div class="reveal" style="margin-top:24px; display:grid; grid-template-columns:1fr 1fr; gap:12px;" class="legal-links-grid">
        <a href="/privacy" style="display:flex; align-items:center; gap:12px; padding:16px 20px; background:var(--surface); border:1px solid var(--border); border-radius:12px; text-decoration:none; transition:transform 0.2s, box-shadow 0.2s, border-color 0.2s;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='var(--shadow-md)'; this.style.borderColor='rgba(37,99,235,0.2)';" onmouseout="this.style.transform=''; this.style.boxShadow=''; this.style.borderColor='var(--border)';">
          <span style="font-size:1.25rem;">🔒</span>
          <div>
            <p style="font-size:0.875rem; font-weight:700; color:var(--ink); margin:0 0 2px;">Privacy Policy</p>
            <p style="font-size:0.75rem; color:var(--text-muted); margin:0;">How we handle your data</p>
          </div>
        </a>
        <a href="/about" style="display:flex; align-items:center; gap:12px; padding:16px 20px; background:var(--surface); border:1px solid var(--border); border-radius:12px; text-decoration:none; transition:transform 0.2s, box-shadow 0.2s, border-color 0.2s;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='var(--shadow-md)'; this.style.borderColor='rgba(37,99,235,0.2)';" onmouseout="this.style.transform=''; this.style.boxShadow=''; this.style.borderColor='var(--border)';">
          <span style="font-size:1.25rem;">ℹ️</span>
          <div>
            <p style="font-size:0.875rem; font-weight:700; color:var(--ink); margin:0 0 2px;">About Infalex</p>
            <p style="font-size:0.75rem; color:var(--text-muted); margin:0;">Our mission and values</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <style>
    @media (max-width: 480px) {
      .legal-links-grid { grid-template-columns: 1fr !important; }
    }
  </style>

</BaseLayout>