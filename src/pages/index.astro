---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Infalex – Practical Knowledge for the Digital Age"
  description="Practical guides on software tools, resume building, and career paths for students and professionals in the modern digital economy."
>

<!-- ═══════════════════════════════════════════
     HERO SECTION
═══════════════════════════════════════════ -->
<section style="position:relative; overflow:hidden; background:var(--surface); padding:100px 0 80px; min-height:90vh; display:flex; align-items:center;">
  
  <!-- Background elements -->
  <div class="hero-grid"></div>
  <div class="hero-glow-1"></div>
  <div class="hero-glow-2"></div>
  <div class="hero-blob"></div>

  <div style="max-width:1200px; margin:0 auto; padding:0 24px; position:relative; z-index:1; width:100%;">
    <div style="max-width:780px;">
      
      <div class="hero-badge animate-fade-up" style="margin-bottom:28px;">
        <span class="pulse-dot"></span>
        New articles published weekly
      </div>

      <h1 class="animate-fade-up stagger-1" style="font-size:clamp(2.5rem,6vw,4.25rem); font-weight:800; letter-spacing:-0.04em; line-height:1.08; margin-bottom:24px; color:var(--ink);">
        Knowledge that<br />
        <span class="shimmer-text">actually helps you</span><br />
        get hired
      </h1>

      <p class="animate-fade-up stagger-2" style="font-size:1.1875rem; color:var(--text-secondary); line-height:1.75; max-width:540px; margin-bottom:40px;">
        Practical guides on resume building, ATS optimization, and career paths — explained in plain English for students, freshers, and professionals.
      </p>

      <div class="animate-fade-up stagger-3" style="display:flex; gap:12px; flex-wrap:wrap;">
        <a href="/blog" class="btn-primary" style="font-size:1rem; padding:16px 32px;">
          Browse Articles
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href="https://tools.infalex.com" class="btn-secondary" style="font-size:1rem; padding:16px 32px;">
          Free Tools
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      </div>

      <!-- Social proof -->
      <div class="animate-fade-up stagger-4" style="display:flex; align-items:center; gap:24px; margin-top:48px; flex-wrap:wrap;">
        <div style="display:flex; align-items:center; gap:-8px;">
          {['S','A','R','K','M'].map((initial, i) => (
            <div style={`width:32px; height:32px; border-radius:50%; background:linear-gradient(135deg, hsl(${i*40+200},70%,55%), hsl(${i*40+220},70%,45%)); border:2px solid white; display:flex; align-items:center; justify-content:center; color:white; font-size:0.7rem; font-weight:700; margin-left:${i > 0 ? '-8px' : '0'};`}>
              {initial}
            </div>
          ))}
        </div>
        <div style="font-size:0.875rem; color:var(--text-secondary);">
          <span style="color:var(--ink); font-weight:700;">10,000+</span> readers growing their careers
        </div>
        <div style="display:flex; gap:2px;">
          {[1,2,3,4,5].map(() => (
            <svg width="14" height="14" fill="#f59e0b" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          ))}
        </div>
      </div>
    </div>

    <!-- Floating cards -->
    <div class="animate-fade-up stagger-4" style="position:absolute; right:0; top:50%; transform:translateY(-50%); display:flex; flex-direction:column; gap:16px; pointer-events:none;" class="hero-cards">
      <div style="background:white; border:1px solid var(--border); border-radius:16px; padding:20px 24px; box-shadow:var(--shadow-lg); width:260px; animation:float 5s ease-in-out infinite;">
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:12px;">
          <div style="width:36px; height:36px; background:linear-gradient(135deg,#22c55e,#16a34a); border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:1.125rem;">✅</div>
          <div>
            <p style="font-size:0.75rem; color:var(--text-muted); margin:0;">ATS Score</p>
            <p style="font-size:1rem; font-weight:800; color:var(--ink); margin:0;">94/100</p>
          </div>
        </div>
        <div style="height:4px; background:var(--surface-3); border-radius:2px; overflow:hidden;">
          <div style="height:100%; width:94%; background:linear-gradient(90deg,#22c55e,#16a34a); border-radius:2px;"></div>
        </div>
      </div>

      <div style="background:white; border:1px solid var(--border); border-radius:16px; padding:20px 24px; box-shadow:var(--shadow-lg); width:260px; animation:float 5s ease-in-out infinite 1.5s; margin-left:32px;">
        <p style="font-size:0.75rem; color:var(--text-muted); margin-bottom:8px;">Keywords Found</p>
        <div style="display:flex; flex-wrap:wrap; gap:6px;">
          {['Python', 'React', 'SQL', 'AWS', 'Agile'].map(kw => (
            <span style="background:var(--blue-soft); color:var(--blue-vivid); font-size:0.7rem; font-weight:600; padding:3px 8px; border-radius:6px;">{kw}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     MARQUEE
═══════════════════════════════════════════ -->
<div style="background:var(--ink); padding:20px 0; overflow:hidden; border-top:1px solid rgba(255,255,255,0.06); border-bottom:1px solid rgba(255,255,255,0.06);">
  <div class="marquee-track">
    {['Resume Optimization', 'ATS Keywords', 'Career Guidance', 'Job Interview Tips', 'Resume vs CV', 'Technical Skills', 'Fresher Guide India', 'BCA Students', 'Software Careers', 'Resume Format 2026', 'Resume Optimization', 'ATS Keywords', 'Career Guidance', 'Job Interview Tips', 'Resume vs CV', 'Technical Skills', 'Fresher Guide India', 'BCA Students', 'Software Careers', 'Resume Format 2026'].map((item, i) => (
      <span style="display:inline-flex; align-items:center; gap:16px; padding:0 24px; white-space:nowrap; font-size:0.8125rem; font-weight:600; color:rgba(255,255,255,0.5); letter-spacing:0.02em;">
        <span style="width:5px; height:5px; background:var(--blue-glow); border-radius:50%; display:inline-block;"></span>
        {item}
      </span>
    ))}
  </div>
</div>

<!-- ═══════════════════════════════════════════
     STATS
═══════════════════════════════════════════ -->
<section style="padding:80px 0; background:var(--surface-2); border-bottom:1px solid var(--border);">
  <div style="max-width:1200px; margin:0 auto; padding:0 24px;">
    <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:32px;" class="stats-grid">
      {[
        { num: '10K+', label: 'Monthly Readers', icon: '👥' },
        { num: '8', label: 'In-Depth Guides', icon: '📚' },
        { num: '94%', label: 'ATS Pass Rate', icon: '🎯' },
        { num: '2026', label: 'Up-to-Date Info', icon: '📅' },
      ].map((stat, i) => (
        <div class="reveal" style={`transition-delay:${i * 0.1}s; text-align:center;`}>
          <div style="font-size:2rem; margin-bottom:12px;">{stat.icon}</div>
          <div class="stat-number">{stat.num}</div>
          <p style="font-size:0.875rem; color:var(--text-secondary); margin-top:6px;">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     FEATURED TOPICS
═══════════════════════════════════════════ -->
<section style="padding:100px 0; background:var(--surface);">
  <div style="max-width:1200px; margin:0 auto; padding:0 24px;">
    
    <div class="reveal" style="text-align:center; margin-bottom:64px;">
      <div class="section-label" style="justify-content:center; margin-bottom:16px;">What We Cover</div>
      <h2 style="font-size:clamp(1.75rem,4vw,2.75rem); font-weight:800; letter-spacing:-0.04em; margin-bottom:16px;">
        Everything you need to <span class="gradient-text">get hired faster</span>
      </h2>
      <p style="font-size:1.0625rem; color:var(--text-secondary); max-width:520px; margin:0 auto;">
        From crafting the perfect resume to acing your first interview — we've got you covered.
      </p>
    </div>

    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:24px;" class="features-grid">
      {[
        {
          icon: '🤖',
          color: 'rgba(37,99,235,0.1)',
          title: 'ATS Optimization',
          desc: 'Learn exactly how Applicant Tracking Systems work and craft resumes that score 90+ every time.',
          link: '/posts/ats-rejection-fix',
        },
        {
          icon: '📄',
          color: 'rgba(6,182,212,0.1)',
          title: 'Resume Formats',
          desc: 'Discover which resume format works best for freshers, experienced candidates, and career changers.',
          link: '/posts/best-ats-resume-format',
        },
        {
          icon: '🔑',
          color: 'rgba(245,158,11,0.1)',
          title: 'Keyword Strategy',
          desc: 'Identify the power words recruiters are searching for and integrate them naturally into your resume.',
          link: '/posts/top-resume-keywords-recruiters-look',
        },
        {
          icon: '📋',
          color: 'rgba(139,92,246,0.1)',
          title: 'Resume vs CV',
          desc: 'Understand when to use a resume vs a CV and how geography changes the rules.',
          link: '/posts/resume-vs-cv-difference-guide',
        },
        {
          icon: '📏',
          color: 'rgba(16,185,129,0.1)',
          title: 'Resume Length',
          desc: 'Find your ideal resume length — one page or two — based on your experience level.',
          link: '/posts/how-long-should-a-resume-be',
        },
        {
          icon: '🇮🇳',
          color: 'rgba(239,68,68,0.1)',
          title: 'India-Specific Tips',
          desc: 'Tailored advice for BCA students and Indian tech freshers breaking into IT.',
          link: '/posts/best-resume-format-bca-students-india',
        },
      ].map((feature, i) => (
        <a href={feature.link} class="feature-card reveal" style={`transition-delay:${i * 0.08}s; text-decoration:none; cursor:pointer;`}>
          <div class="feature-icon" style={`background:${feature.color};`}>{feature.icon}</div>
          <h3 style="font-size:1.0625rem; font-weight:700; letter-spacing:-0.025em; color:var(--ink); margin-bottom:10px;">{feature.title}</h3>
          <p style="font-size:0.875rem; color:var(--text-secondary); line-height:1.65; margin-bottom:20px;">{feature.desc}</p>
          <span style="font-size:0.8125rem; font-weight:600; color:var(--blue-vivid); display:flex; align-items:center; gap:6px;">
            Read guide <span>→</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     LATEST POSTS PREVIEW
═══════════════════════════════════════════ -->
<section style="padding:100px 0; background:var(--surface-2);">
  <div style="max-width:1200px; margin:0 auto; padding:0 24px;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:48px; flex-wrap:wrap; gap:16px;">
      <div class="reveal">
        <div class="section-label">Latest Guides</div>
        <h2 style="font-size:clamp(1.5rem,3.5vw,2.25rem); font-weight:800; letter-spacing:-0.04em;">Recent publications</h2>
      </div>
      <a href="/blog" class="btn-secondary reveal" style="flex-shrink:0;">View all articles →</a>
    </div>

    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:24px;" class="posts-preview-grid">
      {[
        {
          title: 'Stop Sending Your Resume Into a Black Hole',
          desc: 'Learn the critical reasons why ATS systems reject your application and get actionable strategies to fix those issues.',
          date: 'Feb 13, 2026',
          read: '8 min read',
          slug: 'ats-rejection-fix',
          img: '/blog/ATS-Rejection-Fix/Cover.png',
        },
        {
          title: 'Cracking the Code: Top Resume Keywords in 2026',
          desc: 'Unlock the secrets to getting your resume seen with the right keywords and phrases recruiters are actively searching for.',
          date: 'Feb 11, 2026',
          read: '9 min read',
          slug: 'top-resume-keywords-recruiters-look',
          img: '/blog/Top-Resume-Keywords-Recruiters-Look/Cover.png',
        },
        {
          title: 'How Long Should a Resume Be? (2026 Guide)',
          desc: 'Discover the ideal resume length for freshers and experienced candidates, with expert tips to beat the ATS.',
          date: 'Feb 23, 2026',
          read: '10 min read',
          slug: 'how-long-should-a-resume-be',
          img: '/blog/how-long-should-a-resume-be/cover.png',
        },
      ].map((post, i) => (
        <a href={`/posts/${post.slug}`} class="post-card reveal" style={`transition-delay:${i * 0.1}s; text-decoration:none;`}>
          <div class="post-card-image">
            <img src={post.img} alt={post.title} loading="lazy" />
          </div>
          <div class="post-card-body">
            <span class="post-tag">Career Guide</span>
            <h3 class="post-card-title">{post.title}</h3>
            <p class="post-card-excerpt">{post.desc}</p>
            <div class="post-card-footer">
              <div style="font-size:0.75rem; color:var(--text-muted);">{post.date} · {post.read}</div>
              <span class="read-more-arrow">
                Read <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     CTA SECTION
═══════════════════════════════════════════ -->
<section style="padding:80px 0; background:var(--surface);">
  <div style="max-width:1200px; margin:0 auto; padding:0 24px;">
    <div class="reveal-scale" style="background:var(--ink); border-radius:32px; padding:72px 48px; text-align:center; position:relative; overflow:hidden;">
      
      <!-- Decorative glows -->
      <div style="position:absolute; width:400px; height:400px; background:radial-gradient(circle,rgba(37,99,235,0.2),transparent 70%); top:-100px; right:-100px; pointer-events:none;"></div>
      <div style="position:absolute; width:300px; height:300px; background:radial-gradient(circle,rgba(6,182,212,0.15),transparent 70%); bottom:-80px; left:-80px; pointer-events:none;"></div>
      
      <!-- Grid texture -->
      <div style="position:absolute; inset:0; background-image:linear-gradient(rgba(255,255,255,0.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.03) 1px,transparent 1px); background-size:40px 40px; border-radius:32px;"></div>
      
      <div style="position:relative; z-index:1;">
        <div style="display:inline-flex; align-items:center; gap:8px; padding:6px 16px; background:rgba(37,99,235,0.2); border:1px solid rgba(37,99,235,0.4); border-radius:100px; color:rgb(147,197,253); font-size:0.8125rem; font-weight:600; margin-bottom:24px;">
          <span style="width:6px; height:6px; background:#60a5fa; border-radius:50%; display:inline-block;"></span>
          Free to read, forever
        </div>
        
        <h2 style="font-size:clamp(1.75rem,4vw,3rem); font-weight:800; letter-spacing:-0.04em; color:white; margin-bottom:16px; line-height:1.1;">
          Ready to land your<br/>
          <span style="background:linear-gradient(135deg,#60a5fa,#22d3ee); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;">dream job?</span>
        </h2>
        
        <p style="font-size:1.0625rem; color:rgba(255,255,255,0.6); max-width:480px; margin:0 auto 40px; line-height:1.7;">
          Start with our free guides and free ATS scanner. No sign-up required.
        </p>
        
        <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
          <a href="/blog" style="display:inline-flex; align-items:center; gap:8px; padding:14px 28px; background:white; color:var(--ink); font-family:'Sora',sans-serif; font-weight:700; font-size:0.9375rem; border-radius:12px; text-decoration:none; transition:transform 0.2s, box-shadow 0.2s; letter-spacing:-0.02em; box-shadow:0 4px 20px rgba(0,0,0,0.3);" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 12px 40px rgba(0,0,0,0.4)';" onmouseout="this.style.transform=''; this.style.boxShadow='0 4px 20px rgba(0,0,0,0.3)';">
            Read All Guides →
          </a>
          <a href="https://tools.infalex.com" style="display:inline-flex; align-items:center; gap:8px; padding:14px 28px; background:rgba(255,255,255,0.1); color:white; font-family:'Sora',sans-serif; font-weight:600; font-size:0.9375rem; border-radius:12px; text-decoration:none; border:1.5px solid rgba(255,255,255,0.2); transition:background 0.2s, transform 0.2s; letter-spacing:-0.02em;" onmouseover="this.style.background='rgba(255,255,255,0.15)'; this.style.transform='translateY(-2px)';" onmouseout="this.style.background='rgba(255,255,255,0.1)'; this.style.transform='';">
            Try Free ATS Tool ↗
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 1100px) {
    .hero-cards { display: none !important; }
  }
  @media (max-width: 768px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr) !important; }
    .features-grid { grid-template-columns: 1fr !important; }
    .posts-preview-grid { grid-template-columns: 1fr !important; }
  }
  @media (max-width: 480px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr) !important; }
  }
</style>

</BaseLayout>